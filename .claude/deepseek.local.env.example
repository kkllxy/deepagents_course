# Default machine-level DeepSeek config shared by all ccinit projects:
# /home/yy834/.config/ccinit/providers/deepseek.local.env
#
# Edit that shared file once. New ccinit projects will use it automatically.

SHARED_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ccinit/providers/deepseek.local.env"
if [[ -f "$SHARED_ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$SHARED_ENV_FILE"
fi

# Optional per-project overrides only when this project needs something special:
# export ANTHROPIC_MODEL='deepseek-v4-flash'
