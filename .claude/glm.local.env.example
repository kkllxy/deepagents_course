# Default machine-level GLM Coding Plan config shared by all ccinit projects:
# /home/yy834/.config/ccinit/providers/glm.local.env
#
# Edit that shared file once. New ccinit projects will use it automatically.

SHARED_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ccinit/providers/glm.local.env"
if [[ -f "$SHARED_ENV_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$SHARED_ENV_FILE"
fi

# Optional per-project overrides only when this project needs something special:
# export ANTHROPIC_DEFAULT_OPUS_MODEL='glm-4.7'
# export ANTHROPIC_DEFAULT_SONNET_MODEL='glm-4.7'
